{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Island",
  "version": "0.8.0",
  "identifier": "dev.local.claude-island",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Island",
        "width": 480,
        "height": 230,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../hook/island-hook.js": "hook/island-hook.js",
      "../install-hooks.js": "install-hooks.js",
      "../hook/island-status.js": "hook/island-status.js"
    },
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
